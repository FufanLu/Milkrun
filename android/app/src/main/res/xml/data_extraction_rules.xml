<?xml version="1.0" encoding="utf-8"?>
<!-- Route data contains customer addresses: never backed up or transferred to another device. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="database" /><exclude domain="sharedpref" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="database" /><exclude domain="sharedpref" /></device-transfer>
</data-extraction-rules>
